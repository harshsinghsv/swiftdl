{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftDL",
  "version": "0.1.0",
  "identifier": "com.swiftdl.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SwiftDL",
        "width": 1120,
        "height": 700,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#101114",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, resumable download manager",
    "longDescription": "SwiftDL speeds up downloads by splitting each file across many connections, resumes after crashes or network drops, and catches downloads from your browser.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
