{
  "manifest_version": 3,
  "name": "SwiftDL Integration",
  "version": "0.2.2",
  "description": "Sends your downloads to SwiftDL for faster, resumable downloading, and adds a download button to videos.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "SwiftDL",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/32.png", "32": "icons/32.png", "48": "icons/64.png", "128": "icons/128.png" }
}
